# MomentumQuest backend environment.
#
# Copy to .env and fill in. The defaults below are the DEVELOPMENT values --
# every one of them is wrong for a real deployment, so the production notes
# beside each are not optional reading.

# ============================================================
# Django core
# ============================================================

# Generate a fresh value per environment; never reuse the development one:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=generate-a-long-random-value

# PRODUCTION: false.
#
# Leaving this true serves a full traceback -- settings, installed apps, and
# the local variables of the failing frame -- to whoever triggered the error.
# Setting it false also switches on the whole hardening block in settings.py:
# HSTS, secure cookies, the SSL redirect, and a refusal to start on the
# development SECRET_KEY.
DJANGO_DEBUG=true

# PRODUCTION: the real hostnames, comma-separated. No wildcard.
#   DJANGO_ALLOWED_HOSTS=momentumquest.example.edu,api.momentumquest.example.edu
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================================
# Origins
# ============================================================

# PRODUCTION: https, and the real frontend origin. Used in verification and
# password-reset emails, so a wrong value sends students to a dead link.
FRONTEND_URL=http://localhost:3000

# Comma-separated origins allowed to call the API from a browser.
# PRODUCTION: https only. A plain-http origin here means the browser will
# happily send the JWT over the wire in clear.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ============================================================
# Storage
# ============================================================

# Where approved certificates are kept. They carry the student's full name and
# often an identification number, so they live outside MEDIA_ROOT and are
# served only through an ownership-checked view.
#
# PRODUCTION: a path on a mounted volume, NOT inside the checkout. The default
# sits in the repository directory, so a container rebuild or a fresh clone
# would take every stored certificate with it.
#   DJANGO_PRIVATE_MEDIA_ROOT=/var/lib/momentumquest/private_media
# DJANGO_PRIVATE_MEDIA_ROOT=

# Where collectstatic writes. WhiteNoise serves this directly, so no separate
# static server is needed; set it only if the deployment wants the assets
# somewhere specific.
# DJANGO_STATIC_ROOT=

# Set to false only when something in front of the app already redirects to
# HTTPS and this would cause a redirect loop.
# DJANGO_SECURE_SSL_REDIRECT=true

# ============================================================
# Database
# ============================================================

DB_NAME=momentumquest_db
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# ============================================================
# Email
# ============================================================

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=MomentumQuest <your-email@gmail.com>

# Published in the privacy notice as the address students write to about
# their personal data. Defaults to EMAIL_HOST_USER when unset.
PRIVACY_CONTACT_EMAIL=privacy@your-university.edu

# ============================================================
# Bootstrap
# ============================================================

# Read once by `manage.py create_admin`. Public registration accepts students
# and companies only, so this is the supported way to make the first
# administrator. Remove it again after the account exists.
# ADMIN_PASSWORD=
