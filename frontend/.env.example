# MomentumQuest frontend environment.
#
# Copy to .env.local for development. The value below is the DEVELOPMENT one.
#
# NEXT_PUBLIC_* variables are inlined into the JavaScript bundle at BUILD
# time, not read at runtime. Setting this in the production environment after
# `npm run build` changes nothing -- the localhost URL is already compiled
# into the files the browser downloads, and every API call from the deployed
# site goes to the visitor's own machine.
#
# So it has to be set for the build itself:
#
#   NEXT_PUBLIC_API_URL=https://api.momentumquest.example.edu npm run build
#
# or in the build environment of whatever runs the deploy. Use https: the JWT
# is sent on every request, and over plain http it is readable in transit.
#
# It must also match one of the backend's CORS_ALLOWED_ORIGINS, or the browser
# will refuse the response.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
